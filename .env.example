# Firebase 웹 앱 config — 이 파일을 `.env` 로 복사해 값을 채웁니다.
#
# 비밀키가 아닙니다. 브라우저가 어차피 다 보는 공개 식별자라 저장소에
# 들어가도 문제가 없습니다 — 실제 방어선은 `firestore.rules` 입니다
# (docs/TECH_DESIGN.md 4-3).
#
# 값 얻는 곳
#   Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱 추가 → SDK 설정 및 구성
#
# 이 값들이 비어 있으면 로그인·저장·방명록만 잠기고 게임 본편은 그대로 돕니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 이름 있는 Firestore 데이터베이스를 쓸 때만 채웁니다.
# 콘솔에서 Firestore 를 만들 때 「데이터베이스 ID」 를 `(default)` 가 아닌
# 이름으로 두면 그 이름을 여기 적어야 합니다 — 안 적으면 SDK 가 `(default)`
# 만 찾아가서 조회가 통째로 `unavailable` 로 끊깁니다.
# 규칙과 색인도 데이터베이스마다 따로 붙는다는 점을 같이 기억해 둡니다.
VITE_FIREBASE_DATABASE_ID=
